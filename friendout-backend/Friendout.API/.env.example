# Friendout API – Variables d'environnement
# Copier vers .env et renseigner les valeurs. Ne jamais commiter .env.
# Pour les overrides locaux (non versionnés), utiliser .env.local.
# Convention ASP.NET Core : __ = séparation de sections (ex. Authentication__Discord__ClientId).

# ─── Base de données ─────────────────────────────────────────────────────
ConnectionStrings__FriendoutDatabase=Server=localhost;Port=3306;Database=friendoutdb;User=root;Password=your_password

# ─── OAuth Discord (obligatoire) ─────────────────────────────────────────
Authentication__Discord__ClientId=your_discord_client_id
Authentication__Discord__ClientSecret=your_discord_client_secret
Authentication__Discord__CallbackPath=/api/auth/callback/discord

# ─── OAuth Google (obligatoire) ──────────────────────────────────────────
Authentication__Google__ClientId=your_google_client_id
Authentication__Google__ClientSecret=your_google_client_secret
Authentication__Google__CallbackPath=/api/auth/callback/google

# ─── JWT (obligatoire) ───────────────────────────────────────────────────
Jwt__Key=replace_with_a_strong_secret_key_at_least_32_chars
Jwt__Issuer=http://localhost:5122
Jwt__Audience=http://localhost:5173

# ─── Frontend (redirections) ─────────────────────────────────────────────
Frontend__LoginUrl=http://localhost:5173/login
Frontend__ActivitiesUrl=http://localhost:5173/activities

# ─── CORS (origines autorisées, séparées par des virgules si une seule variable) ─
Cors__AllowedOrigins=http://localhost:5122,http://localhost:5173,https://localhost:4173

# ─── Discord – restriction par serveurs (optionnel, IDs séparés par des virgules) ─
Discord__AllowedGuildIds=283997685336375297,677921488799531037

# ─── Seed (optionnel, développement uniquement) ───────────────────────────
# Seed__Enabled=false
