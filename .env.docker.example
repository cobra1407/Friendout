# ─────────────────────────────────────────────────────────────────────────────
# Friendout – Variables d'environnement Docker
# Copier vers .env.docker et renseigner les valeurs.
# NE JAMAIS commiter ce fichier (il est dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── URL publique de l'application ─────────────────────────────────────────
# En local : http://localhost
# En prod  : https://ton-domaine.com
APP_URL=http://localhost

# ── Base de données MySQL ─────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=friendoutdb
MYSQL_USER=friendout
MYSQL_PASSWORD=change_me_db_password

# ── JWT (clé secrète, minimum 32 caractères) ─────────────────────────────
JWT_KEY=replace_with_a_very_strong_secret_key_at_least_32_chars

# ── Discord OAuth ─────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ── Guilds Discord autorisés (IDs séparés par des virgules, laisser vide pour tout autoriser)
DISCORD_ALLOWED_GUILD_IDS=

# ── Seed (true = seeder la DB au démarrage du backend) ───────────────────
SEED_ENABLED=false
