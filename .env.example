# Application Public URL (e.g., http://localhost or https://your-domain.com)
APP_URL=http://localhost

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=friendoutdb
MYSQL_USER=friendout
MYSQL_PASSWORD=change_me_db_password

# JWT Secret Key (minimum 32 characters)
JWT_KEY=replace_with_a_very_strong_secret_key_at_least_32_chars

# Discord OAuth Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email Configuration
SMTP__SERVER=smtp.example.com
SMTP__PORT=587
SMTP__ENABLE_SSL=true
SMTP__USERNAME=your_email@example.com
SMTP__PASSWORD=your_smtp_password
SMTP__FROM_ADDRESS=your_email@example.com
SMTP__FROM_NAME=Friendout

# Seed Database (true = seed DB on backend startup)
SEED_ENABLED=false
