# Normalize line endings to LF in the repository, regardless of OS.
# Git will convert to CRLF on Windows checkouts automatically.
* text=auto eol=lf

# Force LF for source files
*.cs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.conf  text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.dll   binary
